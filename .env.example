# ============================================================
# Docker 集成环境配置示例
# 复制为 .env 后按需修改 (.env 不会被提交到 git)
# ============================================================

# 启用的服务，多个用空格分隔；可选: pgvector mysql redis minio elasticsearch
ENABLED_SERVICES=pgvector mysql redis minio elasticsearch

# Compose 项目名 (决定容器名/网络前缀)
COMPOSE_PROJECT_NAME=docker-env

# ---- pgvector (PostgreSQL + vector) ----
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please
POSTGRES_PORT=5432

# ---- mysql ----
MYSQL_ROOT_PASSWORD=change-me-please
MYSQL_DATABASE=mysql
MYSQL_USER=mysql
MYSQL_PASSWORD=change-me-please
MYSQL_PORT=3306

# ---- redis ----
REDIS_PORT=6379
REDIS_PASSWORD=change-me-please

# ---- minio (S3 兼容对象存储) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-please
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- elasticsearch ----
ELASTIC_PASSWORD=change-me-please
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_MEMORY_LIMIT=1g
