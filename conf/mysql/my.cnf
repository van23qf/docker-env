# ============================================================
# MySQL 8.4 配置
# 挂载到 /etc/mysql/conf.d/my.cnf，由 MySQL 自动加载。
# 数据目录 /var/lib/mysql (映射到宿主机 ./data/mysql)。
# 日志目录 /var/log/mysql   (映射到宿主机 ./logs/mysql)。
# ============================================================

[mysqld]
# ---------- 字符集 ----------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# ---------- 连接 ----------
max_connections = 200

# ---------- 日志 ----------
# 错误日志默认输出到 stderr (可通过 docker logs 查看)
log_error_verbosity = 2

# 慢查询日志 (写入 ./logs/mysql/slow.log)
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

[client]
default-character-set = utf8mb4
